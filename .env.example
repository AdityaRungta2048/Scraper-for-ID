# ---------------------------------------------------------------------------
# Cross-Platform Streamer Identity Matcher — configuration
# Copy to .env and fill in. NEVER commit .env. Secrets are only read by the
# backend; the frontend never sees them.
# ---------------------------------------------------------------------------

# --- Platform credentials (app access tokens via OAuth client-credentials) ---
# Twitch: https://dev.twitch.tv/console/apps  (Register Your Application)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Kick: kick.com -> Settings -> Developer (requires 2FA) -> Create App
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# --- Optional search-engine fallback (candidate discovery only) ---
# Brave Search API key: https://api-dashboard.search.brave.com/
BRAVE_SEARCH_API_KEY=
SEARCH_ENGINE_FALLBACK=true

# --- Optional, undocumented public Kick profile enrichment (bio + social links) ---
# Off by default. Never bypasses bot protection; failures are treated as "unavailable".
KICK_PUBLIC_PROFILE_ENRICHMENT=false

# --- Infrastructure (docker-compose overrides DATABASE_URL/REDIS_URL/QUEUE_BACKEND) ---
DATABASE_URL=sqlite:///./data/matcher.db
# DATABASE_URL=postgresql+psycopg://matcher:matcher@localhost:5432/matcher
REDIS_URL=redis://localhost:6379/0
QUEUE_BACKEND=inline            # inline (single process) | rq (Redis + separate worker)
DATA_DIR=./data
MAX_UPLOAD_MB=25
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
LOG_JSON=true

# --- Existing values in the destination column: preserve | overwrite ---
EXISTING_DESTINATION_POLICY=preserve

# --- Request behaviour ---
API_CONCURRENCY=4
ROW_CONCURRENCY=4
TWITCH_REQUESTS_PER_MINUTE=600
KICK_REQUESTS_PER_MINUTE=120
RETRY_COUNT=4
RETRY_BASE_DELAY=1.0
HTTP_TIMEOUT=15

# --- Cache TTLs (seconds) ---
CACHE_TTL=86400
NEGATIVE_CACHE_TTL=21600
RESOLUTION_CACHE_TTL=259200
IMAGE_CACHE_TTL=604800

# --- Candidate generation ---
MAX_CANDIDATES=15
SEARCH_RESULTS_PER_QUERY=10
IMAGE_MAX_CANDIDATES=6

# --- Scoring (see README "How to tune thresholds") ---
MATCH_THRESHOLD=90
REVIEW_THRESHOLD=70
CONFIDENCE_SCALE=16
CROSS_LINK_WEIGHT=30
SOCIAL_LINK_WEIGHT=25
IMAGE_WEIGHT=20
USERNAME_WEIGHT=15
DISPLAY_NAME_WEIGHT=10
BIO_WEIGHT=10
CONTENT_WEIGHT=5
COUNTRY_WEIGHT=2
IMAGE_SIMILARITY_THRESHOLD=0.90
